# Local frontend setting. In Netlify, set this to the Render API URL, e.g.
# https://scriptflow-api.onrender.com
VITE_API_URL=http://localhost:8000

# Backend settings. Keep real secrets in Render environment variables, never here.
GROQ_API_KEY=replace-with-your-groq-api-key
CORS_ORIGINS=http://localhost:5173
